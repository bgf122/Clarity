// Generated by CMake from src/clarity.rc.in. AoForge identifies Clarity's dinput.dll by ProductName.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Vaporize"
            VALUE "FileDescription", "Clarity - Anarchy Online UI mod (dinput.dll proxy)"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Clarity"
            VALUE "LegalCopyright", "Copyright (c) 2026 Vaporize. MIT License."
            VALUE "OriginalFilename", "dinput.dll"
            VALUE "ProductName", "Clarity"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
